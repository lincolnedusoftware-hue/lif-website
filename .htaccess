# Lincoln International Foundation website (static). Upload to public_html.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Hide git files (the site is deployed from GitHub)
RedirectMatch 404 /\.git
RedirectMatch 404 ^/vercel\.json$

AddType image/avif .avif
AddType font/woff2 .woff2
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
RewriteEngine On

# Always use https://lincolninternationalfoundation.com (no www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://lincolninternationalfoundation.com%{REQUEST_URI} [R=301,L]

# Old WordPress addresses -> new pages
RewriteRule ^programmes/?$ / [R=301,L]
RewriteRule ^ncc-education-level-3/?$ /foundation-year [R=301,L]
RewriteRule ^foundation-year-in-karachi/?$ /foundation-year [R=301,L]
RewriteRule ^international-foundation-year/?$ /foundation-year [R=301,L]
RewriteRule ^(fia-acca|acca-in-karachi|acca|acca-after-matric-pakistan|acca-exemptions-after-fia|acca-fees-in-pakistan|acca-in-pakistan|acca-scope-in-pakistan|acca-vs-ca-pakistan|best-acca-institute-in-karachi|how-long-does-acca-take|what-is-acca-fia)/?$ /blog [R=301,L]
# Guides under internal review (user, 2026-11-11): temporary redirect until each one is approved and republished
RewriteRule ^(is-a-foundation-year-worth-it|study-abroad-after-o-levels|universities-that-accept-ncc-level-3|foundation-year-vs-intermediate|ncc-level-3-entry-requirements|ncc-level-3-explained|ncc-level-3-vs-a-levels|ncc-level-3|what-to-study-after-ncc-level-3)/?$ /blog [R=302,L]
RewriteRule ^about-us/?$ /about [R=301,L]
RewriteRule ^(contact-us|contact)/?$ /apply [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy [R=301,L]
RewriteRule ^(admissions|fees|faq|faqs)/?$ /foundation-year [R=301,L]
RewriteRule ^category/ /blog [R=301,L]
RewriteRule ^author/ /about [R=302,L]
RewriteRule ^feed/?$ /blog [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]

# /page.html -> /page and /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Remove trailing slash (old WordPress links end in /)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.facebook.com; media-src 'self'; style-src 'self'; script-src 'self' https://connect.facebook.net; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://www.facebook.com https://connect.facebook.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
Header always set X-Frame-Options "DENY"
<FilesMatch "^site\..+\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(avif|webp|png|svg|woff2|mp4|jpg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
